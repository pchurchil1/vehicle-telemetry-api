APP_NAME=vehicle-telemetry-api
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
AUTH_ENABLED=false
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

DATABASE_URL=postgresql+psycopg2://app:app@db:5432/telemetry
DATABASE_URL_TEST=postgresql+psycopg2://app:app@db:5432/telemetry_test
